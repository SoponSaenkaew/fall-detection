        <mxCell id="st_susp" value="&lt;b&gt;SUSPECTED_FALL&lt;/b&gt;&lt;br&gt;&lt;font color='#92400E' size='1'&gt;สงสัยว่าล้ม (หน่วงเวลา 2.0s)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;strokeWidth=2;fontFamily=Sarabun;fontSize=13;fontStyle=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#B45309;" vertex="1" parent="1">
