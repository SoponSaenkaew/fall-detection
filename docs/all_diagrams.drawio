        </mxCell>
        <mxCell id="n_esp_node" value="&lt;b&gt;ESP32-S3 Edge Node (MQTT Publisher)&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B' size='1'&gt;• mmWave Radar (LD6002C / LD2410C)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;• Fall Confirmation Logic&lt;br&gt;• Active Buzzer &amp;amp; Status RGB LED&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;• Edge Noise Filtering (FreeRTOS)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.8;fontFamily=Sarabun;fontSize=12;fontColor=#1E40AF;" vertex="1" parent="1">
