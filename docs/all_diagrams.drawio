  <diagram id="fig_2_6" name="2.6 LINE Webhook Flow">
    <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s1" value="&lt;b&gt;1. ESP32-S3 ตรวจพบเหตุการณ์ล้ม&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B' size='1'&gt;เซนเซอร์ mmWave Radar ตรวจจับความผิดปกติ และกรองสัญญาณยืนยันการล้ม&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontFamily=Sarabun;fontSize=12;fontColor=#0F172A;align=left;spacingLeft=65;" vertex="1" parent="1">
          <mxGeometry x="130" y="50" width="560" height="65" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="Edge Hardware" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontFamily=Sarabun;fontSize=10;fontStyle=1;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1D4ED8;" vertex="1" parent="1">
          <mxGeometry x="555" y="66" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontFamily=Sarabun;fontSize=15;fontStyle=1;fontColor=#0F172A;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1D4ED8;" vertex="1" parent="1">
          <mxGeometry x="145" y="60" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. ส่ง Event ขึ้น Go Backend&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B' size='1'&gt;เซิร์ฟเวอร์รับข้อความผ่าน MQTT Broker และบันทึกประวัติลงฐานข้อมูล PostgreSQL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontFamily=Sarabun;fontSize=12;fontColor=#0F172A;align=left;spacingLeft=65;" vertex="1" parent="1">
          <mxGeometry x="130" y="160" width="560" height="65" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="Cloud Backend" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontFamily=Sarabun;fontSize=10;fontStyle=1;strokeWidth=1.2;fillColor=#FAF5FF;strokeColor=#8B5CF6;fontColor=#6D28D9;" vertex="1" parent="1">
          <mxGeometry x="555" y="176" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontFamily=Sarabun;fontSize=15;fontStyle=1;fontColor=#0F172A;fillColor=#FAF5FF;strokeColor=#8B5CF6;fontColor=#6D28D9;" vertex="1" parent="1">
          <mxGeometry x="145" y="170" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3. ยิง HTTP POST JSON Flex Message&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B' size='1'&gt;Go Backend แปลงข้อมูลเป็นรูปแบบการ์ด Flex Message ส่งออกไปยัง LINE Messaging API&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontFamily=Sarabun;fontSize=12;fontColor=#0F172A;align=left;spacingLeft=65;" vertex="1" parent="1">
          <mxGeometry x="130" y="270" width="560" height="65" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="HTTPS REST API" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontFamily=Sarabun;fontSize=10;fontStyle=1;strokeWidth=1.2;fillColor=#F0FDFA;strokeColor=#0D9488;fontColor=#0F766E;" vertex="1" parent="1">
          <mxGeometry x="555" y="286" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontFamily=Sarabun;fontSize=15;fontStyle=1;fontColor=#0F172A;fillColor=#F0FDFA;strokeColor=#0D9488;fontColor=#0F766E;" vertex="1" parent="1">
          <mxGeometry x="145" y="280" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4. LINE Platform ประมวลผลและส่งต่อ&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B' size='1'&gt;เซิร์ฟเวอร์ LINE ตรวจสอบ Channel Access Token และส่ง Push Notification สู่ปลายทาง&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontFamily=Sarabun;fontSize=12;fontColor=#0F172A;align=left;spacingLeft=65;" vertex="1" parent="1">
          <mxGeometry x="130" y="380" width="560" height="65" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="LINE Server" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontFamily=Sarabun;fontSize=10;fontStyle=1;strokeWidth=1.2;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#15803D;" vertex="1" parent="1">
          <mxGeometry x="555" y="396" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontFamily=Sarabun;fontSize=15;fontStyle=1;fontColor=#0F172A;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#15803D;" vertex="1" parent="1">
          <mxGeometry x="145" y="390" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5. แจ้งเตือนเด้งบนสมาร์ตโฟนของผู้ดูแล&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B' size='1'&gt;ข้อความและเสียงเตือนภัยปรากฏทันที พร้อมปุ่มกดดูแดชบอร์ดและปุ่มโทรฉุกเฉิน&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontFamily=Sarabun;fontSize=12;fontColor=#0F172A;align=left;spacingLeft=65;" vertex="1" parent="1">
          <mxGeometry x="130" y="490" width="560" height="65" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="Caregiver App" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontFamily=Sarabun;fontSize=10;fontStyle=1;strokeWidth=1.2;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#B91C1C;" vertex="1" parent="1">
          <mxGeometry x="555" y="506" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontFamily=Sarabun;fontSize=15;fontStyle=1;fontColor=#0F172A;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#B91C1C;" vertex="1" parent="1">
          <mxGeometry x="145" y="500" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="kpi" value="⚡ ระยะเวลาประมวลผลทั้งระบบ (End-to-End Latency) เฉลี่ยไม่เกิน 1.85 – 2.50 วินาที" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#10B981;strokeWidth=1.8;fontFamily=Sarabun;fontSize=12;fontStyle=1;fontColor=#065F46;align=center;" vertex="1" parent="1">
