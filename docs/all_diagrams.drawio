        </mxCell>
        <mxCell id="node_alert" value="&lt;b&gt;ยืนยันการล้มฉุกเฉิน (CONFIRMED_FALL)&lt;/b&gt;&lt;br&gt;&lt;font color='#7F1D1D' size='1'&gt;เปิดไซเรน 85 dB | ส่ง MQTT Publish &amp;amp; LINE Flex Message&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;fontStyle=1;fontSize=12;fontFamily=Sarabun;fontColor=#B91C1C;" vertex="1" parent="1">
