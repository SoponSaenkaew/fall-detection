          <mxGeometry x="80" y="80" width="230" height="85" as="geometry" />
        </mxCell>
        <mxCell id="st_rec" value="&lt;b&gt;RECOVERY / RESET&lt;/b&gt;&lt;br&gt;&lt;font color='#166534' size='1'&gt;ปลดเตือนภัย / เคลียร์ระบบ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;strokeWidth=2;fontFamily=Sarabun;fontSize=13;fontStyle=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#15803D;" vertex="1" parent="1">
          <mxGeometry x="80" y="400" width="230" height="85" as="geometry" />
        </mxCell>
        <mxCell id="st_occ" value="&lt;b&gt;OCCUPIED&lt;/b&gt;&lt;br&gt;&lt;font color='#0284C7' size='1'&gt;มีผู้ใช้งานห้องน้ำปกติ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;strokeWidth=2;fontFamily=Sarabun;fontSize=13;fontStyle=1;fillColor=#F0F9FF;strokeColor=#0284C7;fontColor=#0369A1;" vertex="1" parent="1">
          <mxGeometry x="640" y="80" width="230" height="85" as="geometry" />
