        <mxCell id="c_edge" value="&lt;b&gt;1. Edge Layer (ห้องน้ำ / จุดติดตั้ง)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;fontFamily=Sarabun;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#0F172A;" vertex="1" parent="1">
