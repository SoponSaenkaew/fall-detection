  <diagram id="fig_4_2" name="4.2 Firmware Flowchart">
    <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="node_start" value="เริ่มต้นระบบ (System Start)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontStyle=1;fontSize=13;fontFamily=Sarabun;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="290" y="40" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="node_init" value="&lt;b&gt;กำหนดค่าเริ่มต้นฮาร์ดแวร์และเครือข่าย&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B' size='1'&gt;GPIO, Wi-Fi Station, MQTT Broker, UART 115200&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.8;fontSize=12;fontFamily=Sarabun;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="240" y="110" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="node_d1" value="&lt;b&gt;ตรวจพบบุคคลในห้องน้ำ?&lt;/b&gt;&lt;br&gt;&lt;font color='#2563EB' size='1'&gt;LD2410 GPIO 16 == HIGH&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=12;fontStyle=1;fontFamily=Sarabun;fontColor=#1E40AF;" vertex="1" parent="1">
          <mxGeometry x="260" y="190" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="node_idle" value="สถานะห้องว่าง (IDLE)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.8;fontStyle=1;fontSize=12;fontFamily=Sarabun;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="50" y="195" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="node_occ" value="&lt;b&gt;สถานะมีผู้ใช้งานห้องน้ำ (OCCUPIED)&lt;/b&gt;&lt;br&gt;&lt;font color='#0284C7' size='1'&gt;เปิดไฟสถานะ / ถอดรหัสแพ็กเก็ตเรดาร์ 60 GHz ต่อเนื่อง&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=2;fontStyle=1;fontSize=12;fontFamily=Sarabun;fontColor=#0369A1;" vertex="1" parent="1">
          <mxGeometry x="240" y="290" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="node_d2" value="&lt;b&gt;เรดาร์ 60 GHz ตรวจพบการล้ม?&lt;/b&gt;&lt;br&gt;&lt;font color='#2563EB' size='1'&gt;Frame Type 0x0E02&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=12;fontStyle=1;fontFamily=Sarabun;fontColor=#1E40AF;" vertex="1" parent="1">
          <mxGeometry x="260" y="375" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="node_susp" value="&lt;b&gt;สงสัยว่าหกล้ม (SUSPECTED_FALL)&lt;/b&gt;&lt;br&gt;&lt;font color='#92400E' size='1'&gt;เริ่มนับเวลาหน่วงตรวจสอบ: T_delay = 2.0 วินาที&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontStyle=1;fontSize=12;fontFamily=Sarabun;fontColor=#B45309;" vertex="1" parent="1">
          <mxGeometry x="230" y="475" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="node_d3" value="&lt;b&gt;ลุกขึ้นยืนเองได้ก่อน 2.0 วินาที?&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B' size='1'&gt;ระดับความสูง &amp;gt; 1.0 m&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=12;fontStyle=1;fontFamily=Sarabun;fontColor=#1E40AF;" vertex="1" parent="1">
          <mxGeometry x="250" y="560" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="node_clear" value="&lt;b&gt;ตัดสัญญาณเตือนหลอก&lt;/b&gt;&lt;br&gt;&lt;font color='#166534' size='1'&gt;False Alarm Filtered&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.8;fontStyle=1;fontSize=12;fontFamily=Sarabun;fontColor=#15803D;" vertex="1" parent="1">
