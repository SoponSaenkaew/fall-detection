  <diagram id="fig_3_6" name="3.6 Fall Filter Flow">
    <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="f_start" value="&lt;b&gt;เรดาร์ 60 GHz ส่งสัญญาณตรวจพบการล้ม&lt;/b&gt;&lt;br&gt;&lt;font color='#2563EB' size='1'&gt;TinyFrame Header: 0x0E02&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.8;fontFamily=Sarabun;fontSize=12;fontColor=#1E40AF;" vertex="1" parent="1">
          <mxGeometry x="240" y="50" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f_timer" value="&lt;b&gt;เริ่มต้นจับเวลาหน่วงยืนยันการล้ม (Fall Delay)&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B' size='1'&gt;บันทึก T_start = millis() | หน่วงเวลา T_confirm = 2.0 วินาที&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontFamily=Sarabun;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="240" y="140" width="350" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f_d1" value="&lt;b&gt;ลุกขึ้นยืนเองได้&lt;br&gt;ก่อนครบ 2.0 วินาที?&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B' size='1'&gt;ความสูง &amp;gt; 1.0 m&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=12;fontStyle=1;fontFamily=Sarabun;fontColor=#1E40AF;" vertex="1" parent="1">
          <mxGeometry x="260" y="225" width="310" height="75" as="geometry" />
        </mxCell>
        <mxCell id="f_clear" value="&lt;b&gt;ตัดสัญญาณเตือนหลอก (False Alarm)&lt;/b&gt;&lt;br&gt;&lt;font color='#166534' size='1'&gt;ยกเลิกการนับเวลา / สลับคืน OCCUPIED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.8;fontFamily=Sarabun;fontSize=12;fontStyle=1;fontColor=#15803D;" vertex="1" parent="1">
          <mxGeometry x="30" y="235" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f_alert" value="&lt;b&gt;ยืนยันการล้มฉุกเฉิน (CONFIRMED_FALL)&lt;/b&gt;&lt;br&gt;&lt;font color='#B91C1C' size='1'&gt;เปิดไซเรน 85 dB | ส่ง MQTT &amp;amp; ยิง LINE Flex Message&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;fontFamily=Sarabun;fontSize=12;fontStyle=1;fontColor=#B91C1C;" vertex="1" parent="1">
          <mxGeometry x="220" y="340" width="390" height="65" as="geometry" />
        </mxCell>
        <mxCell id="f_rec_mon" value="&lt;b&gt;เฝ้าระวังการช่วยเหลือตนเอง (Recovery Monitoring)&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B' size='1'&gt;ตรวจสอบเงื่อนไขการฟื้นตัวหรือการปลดสัญญาณเตือนภัย&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontFamily=Sarabun;fontSize=11;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="240" y="440" width="350" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f_d2" value="&lt;b&gt;ยืนตรงต่อเนื่อง &amp;gt;= 2.5s&lt;br&gt;หรือกดปุ่ม Reset?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=12;fontStyle=1;fontFamily=Sarabun;fontColor=#1E40AF;" vertex="1" parent="1">
          <mxGeometry x="260" y="525" width="310" height="75" as="geometry" />
        </mxCell>
        <mxCell id="f_siren_cont" value="&lt;b&gt;แจ้งเตือนภัยต่อเนื่อง&lt;/b&gt;&lt;br&gt;&lt;font color='#B91C1C' size='1'&gt;รอผู้ดูแลเข้าช่วยเหลือ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.8;fontFamily=Sarabun;fontSize=12;fontStyle=1;fontColor=#B91C1C;" vertex="1" parent="1">
