        </mxCell>
        <mxCell id="c_vm" value="&lt;b&gt;2. Azure VM (Burstable B1s - Ubuntu) | Docker Network: proxy-network&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#3B82F6;strokeWidth=1.5;fontFamily=Sarabun;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#1E40AF;" vertex="1" parent="1">
          <mxGeometry x="120" y="260" width="580" height="310" as="geometry" />
        </mxCell>
        <mxCell id="n_mosq" value="&lt;b&gt;Eclipse Mosquitto MQTT Broker (Port 1883)&lt;/b&gt;&lt;br&gt;&lt;font color='#6D28D9' size='1'&gt;Container: prod_mqtt_broker | Topic: fall/device_id/event | TLS/QoS 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7C3AED;strokeWidth=1.8;fontFamily=Sarabun;fontSize=12;fontColor=#6D28D9;" vertex="1" parent="1">
